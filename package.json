{
  "name": "qlaude",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A lightweight Claude Code-style coding agent harness for a locally run Qwen model.",
  "bin": {
    "qlaude": "./bin/qlaude",
    "qlaude-sandbox": "./bin/qlaude-sandbox",
    "qlaude-mcp": "./bin/qlaude-mcp",
    "qlaude-new": "./bin/qlaude-new"
  },
  "scripts": {
    "start": "tsx src/main.ts",
